# Canonical state (PostgreSQL)
DATABASE_URL=postgresql://surake:surake@localhost:5432/surake

# Local artifact storage
ARTIFACT_ROOT=artifacts
PDF_ARTIFACT_ROOT=artifacts
MAX_ARTIFACT_SIZE_MB=25

# Agent services
BROWSER_AGENT_URL=http://localhost:8101
PDF_EDITOR_AGENT_URL=http://localhost:8102
BROWSER_AGENT_MODEL=openai/gpt-4.1-mini

# Jev
JEV_API_KEY=your_jev_api_key

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
OPENAI_API_KEY=your_openai_api_key