{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Surake: Orchestrator",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"--no-sync",
				"uvicorn",
				"surake.app.app:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Surake: Browser Agent",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"--no-sync",
				"--project",
				"services\\browser_agent",
				"uvicorn",
				"browser_agent.main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8101"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Surake: PDF Editor Agent",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"--no-sync",
				"--project",
				"services\\pdf_editor_agent",
				"uvicorn",
				"pdf_editor_agent.main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8102"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
